{
  "version": 1,
  "cmakeMinimumRequired": {"major": 3, "minor": 16, "patch": 0},
  "configurePresets": [
    {
      "name": "default",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build_out",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {"type": "STRING", "value": "Release"},
        "ENABLE_SOURCE_PACKAGE": {"type": "BOOL", "value": "False"},
        "ENABLE_BINARY_PACKAGE": {"type": "BOOL", "value": "True"},
        "ASCEND_COMPUTE_UNIT": {"type": "STRING", "value": "ascend910b"},
        "ENABLE_TEST": {"type": "BOOL", "value": "False"},
        "vendor_name": {"type": "STRING", "value": "prefix_grouper_npu"},
        "ASCEND_CANN_PACKAGE_PATH": {"type": "PATH", "value": "/usr/local/Ascend/cann-9.0.0"},
        "ASCEND_PYTHON_EXECUTABLE": {"type": "STRING", "value": "/usr/bin/python3"},
        "CMAKE_INSTALL_PREFIX": {"type": "PATH", "value": "${sourceDir}/build_out"},
        "ENABLE_CROSS_COMPILE": {"type": "BOOL", "value": "False"},
        "ASCEND_PACK_SHARED_LIBRARY": {"type": "BOOL", "value": "False"}
      }
    }
  ]
}
